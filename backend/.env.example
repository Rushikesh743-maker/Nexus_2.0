# NEXUS backend environment — copy to `backend/.env` and fill in.
#
# PLACEHOLDERS ONLY. Every secret is a placeholder or empty: nothing in this
# file is a working credential, and a real `.env` must never be committed.
#
# NEXUS does NOT require Docker. It is a plain Python (FastAPI) app that talks
# to Supabase PostgreSQL over a standard connection string and, optionally,
# to Supabase Storage over its S3 API. Graph intelligence is computed
# in-process with NetworkX — there is no graph database to install.

# ── Supabase project ───────────────────────────────────────────────────────
# Your project URL (Dashboard → Project Settings → API). Used to derive the
# Supabase Storage S3 endpoint when S3_ENDPOINT_URL is not set explicitly,
# and to document the database connection.
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Low-privilege key. Safe for client-side use; the NEXUS backend does NOT
# use this. (Supabase is moving to publishable/secret keys: the modern
# equivalents are the `publishable` key (replaces anon) and the `secret` key
# (replaces service_role).)
SUPABASE_ANON_KEY=eyJ<your-anon-or-publishable-key>
# Elevated, SERVER-SIDE key (replaces legacy service_role JWT). Full access
# and bypasses Row Level Security — keep it on the backend, out of the
# frontend and out of source control.
SUPABASE_SERVICE_ROLE_KEY=eyJ<your-service-role-or-secret-key>

# ── Database (Supabase PostgreSQL) ─────────────────────────────────────────
# Driver: psycopg 3 (postgresql+psycopg://user:password@host:port/db?sslmode=require)
# From the Supabase Dashboard → Project Settings → Database → Connection
# string, use the *session-mode pooler* (port 5432) so SQLAlchemy's
# connection pooling works normally. The transaction-mode pooler (port 6543)
# multiplexes sessions onto one physical connection and is not compatible
# with default SQLAlchemy pooling. Example:
#   postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# NEXUS applies its schema with Alembic (see docs/DATABASE.md) — the app
# creates no tables implicitly and never drops or alters existing data.
DATABASE_URL=postgresql+psycopg://postgres:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ── Supabase Auth (token verification) ─────────────────────────────────────
# NEXUS verifies the Supabase-issued access token on every protected request;
# it does not issue its own login tokens and stores no passwords. The token
# algorithm is auto-detected from each token's header:
#   * Asymmetric projects (RS256/ES256 — the recommended default): NOTHING
#     needs to be set here. Public keys are fetched from
#     <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
#   * Legacy HS256 projects: set SUPABASE_JWT_SECRET to the project's JWT
#     secret (Dashboard → Project Settings → JWT) so the backend can verify
#     tokens locally.
SUPABASE_JWT_SECRET=

# ── LLM (extraction) ───────────────────────────────────────────────────────
# Empty LLM_PROVIDER => the deterministic rule-based extractor is used (works
# with no credentials). Set LLM_PROVIDER to an OpenAI-compatible provider and
# fill the key (+ optionally model and base URL); the model's JSON output is
# validated with Pydantic, and any failure fails the document honestly.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# ── Document storage ───────────────────────────────────────────────────────
# STORAGE_BACKEND: "local" (development default: filesystem) or "s3"
# (Supabase Storage / any S3-compatible object store). The application only
# ever sees object keys — never filesystem paths.
STORAGE_BACKEND=local
# Local backend root (default: backend/storage, gitignored). Only used for
# the "local" backend.
STORAGE_ROOT=
# S3-compatible object store. For Supabase Storage: leave S3_ENDPOINT_URL
# empty (it is derived from SUPABASE_URL as <SUPABASE_URL>/storage/v1/s3),
# set S3_BUCKET to a PRIVATE bucket, and set the S3 credentials. The secret
# can be the Supabase service-role/secret key (S3_SECRET_ACCESS_KEY falls
# back to SUPABASE_SERVICE_ROLE_KEY when empty); S3_ACCESS_KEY_ID is the
# Supabase Storage S3 access key id.
S3_ENDPOINT_URL=
S3_BUCKET=<private-bucket-name>
S3_PREFIX=
S3_REGION=
S3_ACCESS_KEY_ID=<s3-access-key-id>
S3_SECRET_ACCESS_KEY=<s3-secret-access-key-or-leave-empty-to-use-SUPABASE_SERVICE_ROLE_KEY>

# Upload + extraction limits
MAX_UPLOAD_MB=10
EXTRACTION_MAX_CHARS=200000
EXTRACTION_MAX_ROWS=2000

# ── OCR (scanned PDF pages + image uploads) ────────────────────────────────
# Requires the tesseract-ocr system package (+ languages) and pymupdf. When
# unavailable, scanned pages fail with a clear processing error — they are
# never silently skipped.
OCR_ENABLED=true
OCR_DPI=200

# ── Background document-processing worker ──────────────────────────────────
# Development: the worker runs inside the API process (WORKER_ENABLED=true).
# Production: run it separately (`python -m app.workers.document_worker`)
# and you may set WORKER_ENABLED=false on pure-web API nodes.
WORKER_ENABLED=true
WORKER_POLL_INTERVAL=0.25
WORKER_BATCH_SIZE=5
WORKER_STUCK_TIMEOUT_MINUTES=15

# ── Security ──────────────────────────────────────────────────────────────
# Comma-separated CORS origins (e.g. https://app.example.com). Empty:
# permissive in development (Vite dev server), NO cross-origin access in
# production (APP_ENV=production).
CORS_ORIGINS=
# Response Content-Security-Policy. Empty disables the header.
SECURITY_CSP=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# ── Observability ──────────────────────────────────────────────────────────
# "text" (human-readable) or "json" (one JSON object per line, for shippers)
LOG_FORMAT=text

# ── Application ────────────────────────────────────────────────────────────
# development | staging | production
APP_ENV=development

# ── Copilot LLM provider (stage 5, optional) ─────────────────────────────
# Empty GEMINI_API_KEY => the copilot runs fully deterministic (offline, no
# LLM) and says so in every answer. When set, the model writes answer prose
# only: claims, citations and confidence always come from the deterministic
# layer, the prompt is a bounded context (never the database or graph), and
# every output is validated (citations ⊆ retrieved records, neutral
# language, no unknown names) — any violation falls back honestly.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=20
