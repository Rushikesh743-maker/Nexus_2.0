# Copy to `.env` and adjust.

# ── Supabase Auth (frontend) ─────────────────────────────────────────────────
# Sign-in uses Supabase Auth. Use the project's PUBLIC values only:
#   * VITE_SUPABASE_URL      → project URL   (https://<ref>.supabase.co)
#   * VITE_SUPABASE_ANON_KEY → anon / publishable key
# Never put the service-role / secret key here — it is server-side only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Base URLs ────────────────────────────────────────────────────────────────
# Base URL of the platform backend REST API.
VITE_API_BASE_URL=/api

# When "false", the mock-backed screens call the Axios API client instead of
# local mock data.
VITE_USE_MOCK_API=true

# ── Criminal network analysis backend (FastAPI, see backend/) ────────────────
# Base path the browser calls. In dev, Vite proxies this to the FastAPI server
# (see vite.config.js); in production the same server serves both.
VITE_CNA_API_BASE_URL=/cna-api

# Where the Vite dev proxy forwards /cna-api. Change only if the backend is
# not on the default port.
VITE_CNA_TARGET=http://127.0.0.1:8000
